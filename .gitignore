# Regenerable Paper / server caches (auto-recreated on first startup)
cache/
libraries/
versions/
plugins/.paper-remapped/
plugins/spark/tmp-client/

# Scratch plugin build directory (compiled jar is tracked at plugins/MinecraftMondayCore.jar)
plugin-build/*
!plugin-build/pom.xml

# Logs, crash reports, and runtime state (keeps player IPs off the public repo and avoids file locks)
logs/
crash-reports/
**/session.lock
usercache.json

# Build output and regenerable artefacts of the game plugins / tools
target/
*.class
node_modules/
__pycache__/

# Third-party candidate maps and screenshots (not ours to publish)
_candidates/
# Screenshots of third-party maps used for research stay local
game-plugins/research/img/
game-plugins/research/acerace/
game-plugins/research/dome/
game-plugins/research/*.log
game-plugins/ParkourWarrior/tools/out_old/

# Imported third-party arenas, worlds, and preview renders stay server-local
plugins/McmBattleBox/imported-arenas/
plugins/McmRocketSpleef/imported-arenas/
plugins/McmSurvivalGames/worlds/
mcc_hg_*/
game-plugins/*/previews/imported/
